{
  "name": "mobile-tests",
  "version": "1.0.0",
  "description": "Mobile UI automation for Sauce Labs Sample App — WebDriverIO + Appium",
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "test:login": "wdio run wdio.conf.ts --spec tests/login.spec.ts",
    "test:catalog": "wdio run wdio.conf.ts --spec tests/catalog.spec.ts",
    "test:purchase": "wdio run wdio.conf.ts --spec tests/purchase.spec.ts",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "report": "npm run allure:generate && npm run allure:open"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@wdio/allure-reporter": "^8.0.0",
    "@wdio/cli": "^8.0.0",
    "@wdio/local-runner": "^8.0.0",
    "@wdio/mocha-framework": "^8.0.0",
    "@wdio/spec-reporter": "^8.0.0",
    "allure-commandline": "^2.29.0",
    "appium-uiautomator2-driver": "^2.0.0",
    "chai": "^4.3.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0",
    "webdriverio": "^8.0.0"
  }
}
