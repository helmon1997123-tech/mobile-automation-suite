{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "types": ["node", "@wdio/globals/types", "expect-webdriverio", "mocha"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}